{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeKerf",
  "version": "0.1.1",
  "identifier": "io.github.freekerf.FreeKerf",
  "build": {
    "frontendDist": "../../../ui/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../../ui/web run dev",
    "beforeBuildCommand": "npm --prefix ../../ui/web run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "FreeKerf",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Design jobs and drive laser machines",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "electronics",
        "desktopTemplate": "../../../packaging/linux/io.github.freekerf.FreeKerf.desktop.in",
        "files": {
          "/usr/bin/freekerf": "../../../target/release/freekerf",
          "/usr/share/metainfo/io.github.freekerf.FreeKerf.metainfo.xml": "../../../packaging/linux/io.github.freekerf.FreeKerf.metainfo.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/bin/freekerf": "../../../target/release/freekerf",
          "/usr/share/metainfo/io.github.freekerf.FreeKerf.metainfo.xml": "../../../packaging/linux/io.github.freekerf.FreeKerf.metainfo.xml"
        }
      }
    }
  }
}
